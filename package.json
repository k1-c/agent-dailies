{
  "name": "agent-dailies",
  "version": "0.2.0",
  "description": "A live review page for what your coding agent makes: it shows images, videos, audio and 3D models in one browser tab instead of opening windows, asks you to decide there, and brings your answers back to the agent.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "dailies",
    "review",
    "viewer",
    "assets",
    "gamedev"
  ],
  "homepage": "https://github.com/k1-c/agent-dailies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1-c/agent-dailies.git"
  },
  "bugs": "https://github.com/k1-c/agent-dailies/issues",
  "license": "MIT",
  "author": "k1-c",
  "type": "module",
  "bin": {
    "agent-dailies": "dist/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "web",
    "hooks",
    "skills",
    ".claude-plugin",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup": "npm install --prefix dev",
    "typecheck": "dev/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "build": "dev/node_modules/.bin/tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "verify": "npm run typecheck && npm test && npm run build",
    "vendor": "cp dev/node_modules/@google/model-viewer/dist/model-viewer.min.js web/vendor/",
    "prepack": "npm run build"
  }
}
